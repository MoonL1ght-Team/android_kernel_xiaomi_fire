# Fire early boot diagnostic profile.
# Keep printk/serial/pstore paths, but remove early EL2, memory-tagging,
# instrumentation and hardening features while chasing pre-printk stalls.
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_KVM is not set
# CONFIG_NVHE_EL2_DEBUG is not set
# CONFIG_PROTECTED_NVHE_STACKTRACE is not set
# CONFIG_MTK_PKVM_MKP is not set
# CONFIG_MTK_PKVM_MTK_SMC_HANDLER is not set
# CONFIG_MTK_PKVM_SMMU is not set
# CONFIG_MTK_PKVM_TMEM is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KASAN_SW_TAGS is not set
# CONFIG_KASAN_VMALLOC is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_HARDENED_USERCOPY is not set
# CONFIG_SLAB_FREELIST_RANDOM is not set
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_PRINTK_CALLER=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVICE_MODULES_SERIAL_8250_MT6577=m
CONFIG_MTK_PRINTK_FORCE_UART_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
