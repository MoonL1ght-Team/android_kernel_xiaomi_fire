CONFIG_OEM_PROJECT=y
CONFIG_PROJECT_FIRE=y
CONFIG_OEM_TINNO_CHARGER=m
CONFIG_OEM_HVDCP_ALGO=m
CONFIG_OEM_PDC_ALGO=m
CONFIG_OEM_FIRE_TOUCHSCREEN=m
CONFIG_OEM_FIRE_PANEL=m
CONFIG_OEM_FIRE_FINGERPRINT=m
CONFIG_OEM_TCPC=m
CONFIG_OEM_TCPC_HUSB320=m
CONFIG_MTK_REAR_ALS_HUB=y
CONFIG_MTK_LCM_PHYSICAL_ROTATION="0"
CONFIG_LCM_HEIGHT="2460"
CONFIG_LCM_WIDTH="1080"
CONFIG_MMC_BLOCK_MINORS=32

# Fire-specific 4.19 drivers still need 6.6/KMI adaptation before enabling:
# - SYV690 charger
# - AW3641E flashlight
# - M19A DSI panels
CONFIG_CHARGER_SYV690=m
