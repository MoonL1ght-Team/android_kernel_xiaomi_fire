# MediaTek vendor drivers from kernel_device_modules-6.6, ported to 6.12
# for Xiaomi fire. Paths mirror the vendor tree so its Makefiles work.
export DEVICE_MODULES_PATH := $(src)

obj-$(CONFIG_FIRE_MTK_VENDOR_DRM) += drivers/gpu/drm/mediatek/mediatek_v2/
obj-$(CONFIG_FIRE_MTK_VENDOR_DRM) += drivers/gpu/drm/mediatek/mtk_sync/
obj-$(CONFIG_FIRE_MTK_VENDOR_DRM) += drivers/gpu/drm/panel/
obj-$(CONFIG_FIRE_MTK_VENDOR_DRM) += fire/
obj-$(CONFIG_MTK_CMDQ_MBOX_EXT) += drivers/misc/mediatek/cmdq/mailbox/
obj-$(CONFIG_FIRE_MTK_MDP) += drivers/misc/mediatek/mdp/
obj-$(CONFIG_DEVICE_MODULES_MTK_SMI) += drivers/memory/
obj-$(CONFIG_DEVICE_MODULES_MTK_IOMMU) += drivers/iommu/
obj-$(CONFIG_DEVICE_MODULES_MTK_SCPSYS) += drivers/soc/mediatek/
obj-$(CONFIG_MTK_MT6382_BDG) += drivers/misc/mediatek/spi_slave_drv/
obj-$(CONFIG_MTK_MT6382_BDG) += drivers/misc/mediatek/cmdq/bridge/
obj-$(CONFIG_FIRE_MTK_VENDOR_GPU) += drivers/gpu/mediatek/
obj-$(CONFIG_FIRE_TOUCHSCREEN_FT8720) += drivers/input/touchscreen/focaltech_FT8720/
obj-$(CONFIG_FIRE_MTK_KPD) += drivers/input/keyboard/
obj-$(CONFIG_FIRE_SPI_MT65XX_VENDOR) += drivers/spi/
obj-$(CONFIG_FIRE_I2C_MT65XX_VENDOR) += drivers/i2c/
