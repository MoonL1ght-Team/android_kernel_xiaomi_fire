load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "sources",
    srcs = glob([
        "**",
    ], exclude = [
        "BUILD.bazel",
    ]),
)

define_mgk_ko(
    name = "mtk_sync",
    srcs = [
        ":sources",
        "//kernel_device_modules-6.6/drivers/gpu/drm/mediatek/mediatek_v2:mtk_sync.c",
    ],
    outs = [
        "mtk_sync.ko",
    ],
)
